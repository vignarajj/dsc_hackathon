META_API_KEY=
# Optional overrides
# META_BASE_URL=https://api.meta.ai/v1
# SAM_MODEL=sam-3.1
# MUSE_VISION_MODEL=muse-spark-1.3
# MUSE_TEXT_MODEL=muse-spark-1.3
# MUSE_SIGNATURE_MODEL=muse-spark-1.3
# Black out sensitive text inside the share-safe image. Off until checked on real photos.
# REDACT_IMAGE_TEXT=false
# MUSE_TEXT_BOX_MODEL=muse-wonder-1.0
# SAM_CONCEPTS=stamp,signature,photograph,rectangle
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# UPSTREAM_TIMEOUT_SECONDS=60
# Turn an optional Muse feature off on this server, to cap calls on a public copy.
# FEATURE_EXTRACT=true
# FEATURE_DESCRIBE=true
# FEATURE_PRIVACY=true
# One deadline for the optional steps (signatures, descriptions, fields, personal details).
# REQUEST_BUDGET_SECONDS=150
# Requests per minute per client IP for /api/process. 0 turns the limit off.
# RATE_LIMIT_PER_MINUTE=0
